@{
    ViewData["Title"] = "Dashboard";
}

<!-- AI Skills Agent: Kullanıcı deneyimi ve analiz ekranı akışı frontend odaklı optimize edilmiştir. -->

<!-- Modern Hero Alanı -->
<div class="row mb-5 mt-3">
    <div class="col-12 text-center">
        <h1 class="display-4 fw-bolder text-primary mb-3">MeetFlow AI</h1>
        <p class="lead text-muted mx-auto" style="max-width: 600px;">
            Toplantı notlarını saniyeler içinde analiz edin, görevleri ve kararları otomatik çıkarın.
        </p>
    </div>
</div>

<!-- Üst İstatistik Alanı -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-light rounded-circle p-3 me-3 text-secondary">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">Manuel Süre</h6>
                    <h4 class="mb-0 text-dark fw-bolder">45 <small class="text-muted fs-6 fw-normal">dk</small></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-white h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3 text-warning">
                    <i class="bi bi-lightning-charge fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">AI Süresi</h6>
                    <h4 class="mb-0 text-dark fw-bolder">15 <small class="text-muted fs-6 fw-normal">sn</small></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white h-100 shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3 text-white">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
                <div>
                    <h6 class="text-white-50 text-uppercase mb-1 small fw-bold">Kazanılan Süre</h6>
                    <h4 class="mb-0 fw-bolder">44.75 <small class="text-white-50 fs-6 fw-normal">dk</small></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white h-100 shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3 text-white">
                    <i class="bi bi-percent fs-4"></i>
                </div>
                <div>
                    <h6 class="text-white-50 text-uppercase mb-1 small fw-bold">Verimlilik</h6>
                    <h4 class="mb-0 fw-bolder">+99%</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Sol Panel – Toplantı Metni Girişi -->
    <div class="col-lg-5 mb-4">
        <div class="card h-100">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                <h5 class="card-title fw-bold text-dark"><i class="bi bi-journal-text me-2 text-primary"></i>Toplantı Metni</h5>
            </div>
            <div class="card-body d-flex flex-column">
                <textarea id="meetingText" class="form-control mb-3 flex-grow-1 bg-light border-0" style="min-height: 300px; resize: none;" placeholder="Lütfen toplantı deşifresini veya notlarınızı buraya yapıştırın..."></textarea>
                
                <div class="mb-4">
                    <label class="form-label text-muted small fw-bold text-uppercase">Demo Senaryoları</label>
                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" onclick="loadDemo('software')">
                            <i class="bi bi-code-slash me-1"></i>Yazılım
                        </button>
                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="loadDemo('crisis')">
                            <i class="bi bi-exclamation-triangle me-1"></i>Kriz
                        </button>
                        <button class="btn btn-outline-info btn-sm rounded-pill px-3" onclick="loadDemo('management')">
                            <i class="bi bi-briefcase me-1"></i>Yönetim
                        </button>
                    </div>
                </div>

                <button id="btnAnalyze" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow-sm" onclick="analyzeMeeting()">
                    <i class="bi bi-magic me-2"></i>Analiz Et
                </button>
            </div>
        </div>
    </div>

    <!-- Sağ Panel – Analiz Sonucu Görünümü -->
    <div class="col-lg-7 mb-4">
        <!-- Results Container -->
        <div class="card h-100" id="resultsContainer" style="display: none;">
            <div class="card-header bg-white border-bottom-0 pt-4 pb-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-ui-checks-grid me-2 text-success"></i>Analiz Sonuçları</h5>
                <button class="btn btn-sm btn-success fw-bold px-3 rounded-pill shadow-sm" onclick="copyReport()">
                    <i class="bi bi-clipboard me-1"></i>Raporu Kopyala
                </button>
            </div>
            <div class="card-body overflow-auto" style="max-height: 700px;" id="reportContent">
                
                <!-- Özet -->
                <div class="bg-light p-3 rounded-3 mb-4 border-start border-4 border-primary">
                    <h6 class="text-primary fw-bold mb-2"><i class="bi bi-card-text me-2"></i>Özet</h6>
                    <p id="resSummary" class="text-dark mb-0"></p>
                </div>

                <div class="row">
                    <!-- Skor Kartları -->
                    <div class="col-md-4 mb-3">
                        <div class="border rounded-3 p-3 text-center h-100">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">Risk Skoru</h6>
                            <h3 class="text-danger fw-bold mb-0" id="resRiskScore">0/10</h3>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="border rounded-3 p-3 text-center h-100">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">Kalite Skoru</h6>
                            <h3 class="text-success fw-bold mb-0" id="resQualityScore">0/10</h3>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="border rounded-3 p-3 text-center h-100">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">İş Yükü</h6>
                            <h3 class="text-info fw-bold mb-0" id="resWorkload">Dengeli</h3>
                        </div>
                    </div>
                </div>

                <div class="row mt-2">
                    <!-- Alınan Kararlar -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-success fw-bold border-bottom pb-2"><i class="bi bi-check2-circle me-2"></i>Alınan Kararlar</h6>
                        <ul id="resDecisions" class="list-unstyled text-dark"></ul>
                    </div>

                    <!-- Görevler -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-info fw-bold border-bottom pb-2"><i class="bi bi-list-task me-2"></i>Görevler / Action Items</h6>
                        <ul id="resTasks" class="list-unstyled text-dark"></ul>
                    </div>
                </div>

                <div class="row">
                    <!-- Riskler -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-danger fw-bold border-bottom pb-2"><i class="bi bi-shield-exclamation me-2"></i>Riskler & Blokajlar</h6>
                        <ul id="resRisks" class="list-unstyled text-dark"></ul>
                    </div>

                    <!-- Deadline'lar -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-warning fw-bold border-bottom pb-2" style="color: #d97706 !important;"><i class="bi bi-calendar-event me-2"></i>Deadline’lar</h6>
                        <ul id="resDeadlines" class="list-unstyled text-dark"></ul>
                    </div>
                </div>

                <div class="row">
                    <!-- Katılımcılar -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-secondary fw-bold border-bottom pb-2"><i class="bi bi-people me-2"></i>Katılımcılar</h6>
                        <div id="resParticipants" class="d-flex flex-wrap gap-2 mt-2"></div>
                    </div>

                    <!-- Önerilen Sonraki Adım -->
                    <div class="col-md-6 mb-4">
                        <h6 class="text-primary fw-bold border-bottom pb-2"><i class="bi bi-arrow-right-circle me-2"></i>Önerilen Sonraki Adım</h6>
                        <div class="bg-primary bg-opacity-10 p-2 rounded-3 mt-2">
                            <p id="resNextStep" class="text-primary fw-bold small mb-0"></p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Bekleme Ekranı (Empty / Loading State) -->
        <div class="card h-100 d-flex justify-content-center align-items-center bg-white border" id="emptyState" style="min-height: 500px; border: 2px dashed #e2e8f0 !important;">
            <div class="text-center text-muted p-5">
                <i class="bi bi-robot fs-1 mb-3 text-primary opacity-50"></i>
                <h5 id="emptyStateText" class="fw-bold text-secondary">Analiz Sonucu Bekleniyor</h5>
                <p class="small text-muted" id="emptyStateSubText">Toplantı analizi için metin girin ve Analiz Et butonuna tıklayın.</p>
                <div id="loadingSpinner" class="spinner-border text-primary mt-3" role="status" style="display: none;">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const scenarios = {
            software: {
                text: "Ahmet: Arkadaşlar merhaba, sprint planlama toplantısına hoş geldiniz. Ayşe, frontend logindeki JWT token sorununu çözdün mü?\nAyşe: Merhaba Ahmet. Evet çözdüm, PR açtım. Ancak backend tarafında yeni API endpointi henüz hazır değil. Mehmet o kısmı yarına yetiştirebilir misin?\nMehmet: Yarın öğleye kadar bitirmiş olurum. Yalnız veritabanında migration patlayabilir, risk var. Ali'nin kontrol etmesi lazım.\nAhmet: Tamam, Mehmet yarın öğleye kadar backend API'yi bitirecek. Ali, lütfen bugün migration'ı test et. Bu bir risk. Karar olarak: Auth sistemi yarına canlıya alınacak. Sonraki adım: Test ortamında tam entegrasyon denemesi yapmak.",
                mockData: {
                    summary: "Sprint planlama toplantısında JWT token sorununun çözüldüğü belirtildi ve backend API geliştirmesi ile veritabanı migration süreçleri planlandı.",
                    decisions: ["Auth sistemi yarına canlıya alınacak."],
                    tasks: ["Mehmet: Backend API endpointini yarına kadar bitir.", "Ali: Bugün migration'ı test et."],
                    risks: ["Veritabanı migration'ı patlayabilir."],
                    deadlines: ["Backend API: Yarın öğle", "Migration Test: Bugün"],
                    participants: ["Ahmet", "Ayşe", "Mehmet", "Ali"],
                    nextStep: "Test ortamında tam entegrasyon denemesi yapmak.",
                    riskScore: "4/10",
                    qualityScore: "8.5/10",
                    workload: "Yoğun (Backend)"
                }
            },
            crisis: {
                text: "Can: Acil durum! Prod veritabanı %99 CPU kullanımında, sistem yavaşladı. Zeynep, acil loglara bakar mısın?\nZeynep: Bakıyorum... Son deploy edilen rapordan kaynaklı çok ağır bir sorgu var. Acil rollback yapalım mı?\nCan: Evet, hemen rollback yapıyoruz. Karar: Son deploy geri alınacak. Görev: Zeynep, rollback işlemini başlat. 15 dakika içinde sistemi ayağa kaldırmamız lazım. Hakan, sen de o arada ağır sorguyu optimize et.\nHakan: Anlaşıldı. Rollback sonrası sorguyu indexleyeceğim. Risk şu ki müşteri rapor alamıyor şu an. Sonraki adım: Veritabanı monitoring alarmlarını sıkılaştırmak.",
                mockData: {
                    summary: "Sistemdeki %99 CPU kullanımına yol açan ağır sorgu tespit edildi, acil rollback kararı alındı ve optimizasyon süreci başlatıldı.",
                    decisions: ["Son deploy acil olarak geri alınacak."],
                    tasks: ["Zeynep: Rollback işlemini başlat.", "Hakan: Ağır sorguyu optimize et."],
                    risks: ["Müşteriler şu an rapor alamıyor.", "Sistem kesintisi riski."],
                    deadlines: ["Sistemi ayağa kaldırma: 15 dakika içinde"],
                    participants: ["Can", "Zeynep", "Hakan"],
                    nextStep: "Veritabanı monitoring alarmlarını sıkılaştırmak.",
                    riskScore: "9/10",
                    qualityScore: "7.0/10",
                    workload: "Çok Yoğun"
                }
            },
            management: {
                text: "Elif: Q3 hedeflerimiz hakkında konuşalım. Satışlar beklentinin altında kaldı. Murat, pazarlama bütçesini artırabilir miyiz?\nMurat: Bütçemiz kısıtlı ama sosyal medya reklamlarına ağırlık verebiliriz. Bunun için ek 50.000 TL bütçe onaylıyorum.\nElif: Harika. Karar: Sosyal medya reklam bütçesi 50.000 TL artırıldı. Görev: Ayşe, haftaya pazartesiye kadar yeni reklam kampanyası taslaklarını hazırla. Risk: Reklam dönüşümleri yeterli olmazsa yıl sonu hedefi tutmayabilir. Sonraki adım: Çarşamba günü taslaklar üzerinden tekrar toplanıp onaylamak.",
                mockData: {
                    summary: "Q3 satışlarının düşük kalması sebebiyle sosyal medya reklam bütçesi artırıldı ve yeni kampanya süreci planlandı.",
                    decisions: ["Sosyal medya reklam bütçesi 50.000 TL artırıldı."],
                    tasks: ["Ayşe: Yeni reklam kampanyası taslaklarını hazırla."],
                    risks: ["Reklam dönüşümleri yetersiz kalırsa yıl sonu hedefi tutmayabilir."],
                    deadlines: ["Reklam taslakları: Haftaya pazartesi", "Onay toplantısı: Çarşamba"],
                    participants: ["Elif", "Murat", "Ayşe"],
                    nextStep: "Çarşamba günü taslaklar üzerinden tekrar toplanıp onaylamak.",
                    riskScore: "3/10",
                    qualityScore: "9.2/10",
                    workload: "Dengeli"
                }
            }
        };

        let currentMockData = null;

        function loadDemo(type) {
            const data = scenarios[type];
            if(data) {
                document.getElementById('meetingText').value = data.text;
                currentMockData = data.mockData;
            }
        }

        function analyzeMeeting() {
            const text = document.getElementById('meetingText').value.trim();
            if(!text) {
                alert("Lütfen analiz etmek için bir toplantı metni girin.");
                return;
            }

            if (!currentMockData) {
                currentMockData = scenarios['software'].mockData;
            }

            // Show loading state
            document.getElementById('resultsContainer').style.display = 'none';
            document.getElementById('emptyState').style.display = 'flex';
            document.getElementById('emptyStateText').innerText = "Yapay zeka metni analiz ediyor, lütfen bekleyin...";
            document.getElementById('emptyStateSubText').style.display = 'none';
            document.getElementById('loadingSpinner').style.display = 'inline-block';
            
            const btn = document.getElementById('btnAnalyze');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Analiz Ediliyor...';

            setTimeout(() => {
                populateResults(currentMockData);
                
                // Hide loading, show results
                document.getElementById('emptyState').style.display = 'none';
                document.getElementById('resultsContainer').style.display = 'block';
                
                // Reset button
                btn.disabled = false;
                btn.innerHTML = '<i class="bi bi-magic me-2"></i>Analiz Et';
                
                // Reset empty state texts for next time
                document.getElementById('emptyStateText').innerText = "Analiz Sonucu Bekleniyor";
                document.getElementById('emptyStateSubText').style.display = 'block';
                document.getElementById('loadingSpinner').style.display = 'none';
            }, 1500);
        }

        function populateResults(data) {
            document.getElementById('resSummary').innerText = data.summary;
            document.getElementById('resNextStep').innerText = data.nextStep;
            document.getElementById('resRiskScore').innerText = data.riskScore;
            document.getElementById('resQualityScore').innerText = data.qualityScore;
            document.getElementById('resWorkload').innerText = data.workload;

            const makeList = (items) => items.map(i => `<li class="mb-2"><i class="bi bi-caret-right-fill text-muted me-1 small"></i> ${i}</li>`).join('');
            
            document.getElementById('resDecisions').innerHTML = makeList(data.decisions);
            document.getElementById('resTasks').innerHTML = makeList(data.tasks);
            document.getElementById('resRisks').innerHTML = makeList(data.risks);
            document.getElementById('resDeadlines').innerHTML = makeList(data.deadlines);

            const badges = data.participants.map(p => `<span class="badge bg-secondary px-3 py-2 rounded-pill">${p}</span>`).join('');
            document.getElementById('resParticipants').innerHTML = badges;
        }

        function copyReport() {
            const reportNode = document.getElementById('reportContent');
            const text = reportNode.innerText; 
            
            navigator.clipboard.writeText(text).then(() => {
                alert("Rapor başarıyla panoya kopyalandı!");
            }).catch(err => {
                console.error("Kopyalama hatası: ", err);
                alert("Kopyalanırken bir hata oluştu.");
            });
        }
    </script>
}
