@model MeetFlow.Web.ViewModels.MeetingAnalysisRequestViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- AI destekli kullanıcı deneyimi optimizasyonu uygulanmıştır. -->

<style>
    /* Custom Animations and Overrides */
    .fade-in { animation: fadeIn 0.8s ease forwards; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    .typing-text::after {
        content: '|';
        animation: blink 1s step-start infinite;
    }
    @@keyframes blink { 50% { opacity: 0; } }

    .task-item:hover { background-color: #f8f9fa; border-radius: 0.5rem; }
    .analysis-history-card { cursor: pointer; border-left: 4px solid transparent; transition: all 0.2s; }
    .analysis-history-card:hover { border-left-color: #0d6efd; background-color: #f8f9fa; }

    /* Circular Progress minimal CSS */
    .progress-bar-custom {
        height: 8px;
        border-radius: 4px;
    }
</style>

<!-- Modern Hero Alanı   -->
<div class="row mb-5 mt-3 fade-in">
    <div class="col-12 text-center">
        <h1 class="display-4 fw-bolder mb-3"><span class="gradient-text">MeetFlow AI</span></h1>
        <p class="lead text-muted mx-auto" style="max-width: 600px;">
            Toplantı notlarını saniyeler içinde analiz edin, görevleri ve kararları otomatik çıkarın.
        </p>
    </div>
</div>

<!-- Üst İstatistik Alanı -->
<div class="row mb-4 fade-in" style="animation-delay: 0.1s;">
    <div class="col-md-3 mb-3">
        <div class="card glass-card card-hover h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-light rounded-circle p-3 me-3 text-secondary shadow-sm">
                    <i class="bi bi-clock-history fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">Manuel Süre</h6>
                    <h4 class="mb-0 text-dark fw-bolder">45 <small class="text-muted fs-6 fw-normal">dk</small></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card glass-card card-hover h-100">
            <div class="card-body d-flex align-items-center">
                <div class="bg-warning bg-opacity-10 rounded-circle p-3 me-3 text-warning shadow-sm">
                    <i class="bi bi-lightning-charge fs-4"></i>
                </div>
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">AI Süresi</h6>
                    <h4 class="mb-0 text-dark fw-bolder">15 <small class="text-muted fs-6 fw-normal">sn</small></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card card-hover bg-success text-white h-100 shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3 text-white">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
                <div>
                    <h6 class="text-white-50 text-uppercase mb-1 small fw-bold">Kazanılan Süre</h6>
                    <h4 class="mb-0 fw-bolder">44.75 <small class="text-white-50 fs-6 fw-normal">dk</small></h4>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card card-hover bg-primary text-white h-100 shadow-sm border-0">
            <div class="card-body d-flex align-items-center">
                <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3 text-white">
                    <i class="bi bi-percent fs-4"></i>
                </div>
                <div>
                    <h6 class="text-white-50 text-uppercase mb-1 small fw-bold">Verimlilik</h6>
                    <h4 class="mb-0 fw-bolder">+99%</h4>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row fade-in" style="animation-delay: 0.2s;">
    <!-- Sol Panel – Toplantı Metni Girişi & Geçmiş -->
    <div class="col-lg-5 mb-4">
        <!-- AI Skills Agent: Canlı konuşmayı metne aktarma akışı Web Speech API ile frontend seviyesinde entegre edilmiştir. -->
        <!-- Sesli Not Al Alanı -->
        <div class="card glass-card mb-4 border-0 shadow-sm card-hover">
            <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                <h5 class="card-title fw-bold text-dark"><i class="bi bi-mic-fill me-2 text-danger"></i>Sesli Not Al</h5>
            </div>
            <div class="card-body">
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button id="btnStartRecording" class="btn btn-danger btn-sm fw-bold px-3 rounded-pill shadow-sm" onclick="startSpeechRecognition()">
                        <i class="bi bi-mic me-1"></i>Kaydı Başlat
                    </button>
                    <button id="btnStopRecording" class="btn btn-outline-secondary btn-sm fw-bold px-3 rounded-pill shadow-sm" onclick="stopSpeechRecognition()" disabled>
                        <i class="bi bi-stop-circle me-1"></i>Kaydı Durdur
                    </button>
                    <button id="btnClearText" class="btn btn-outline-dark btn-sm fw-bold px-3 rounded-pill shadow-sm ms-auto" onclick="clearSpeechText()">
                        <i class="bi bi-eraser-fill me-1"></i>Metni Temizle
                    </button>
                </div>
                <div class="alert alert-light border small text-muted mb-0 d-flex align-items-center" role="alert" id="speechStatusAlert">
                    <span id="speechPulseIndicator" class="pulse-ring d-none me-2"></span>
                    <span id="speechStatusText">Mikrofon hazır.</span>
                </div>
            </div>
        </div>

        <div class="card glass-card h-100 mb-4">
            <div class="card-header bg-transparent border-bottom-0 pt-4 pb-0">
                <h5 class="card-title fw-bold text-dark"><i class="bi bi-journal-text me-2 text-primary"></i>Toplantı Metni</h5>
            </div>
            <div class="card-body d-flex flex-column">
                <form method="post" action="/Home/Analyze" class="d-flex flex-column flex-grow-1">
                    <textarea name="MeetingText" id="MeetingText" class="form-control mb-3 flex-grow-1 bg-white bg-opacity-75 border" style="min-height: 250px; resize: vertical;" placeholder="Lütfen toplantı deşifresini veya notlarınızı buraya yapıştırın...">@(Model?.MeetingText)</textarea>
                    
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold text-uppercase">Demo Senaryoları</label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" onclick="loadDemo('software')">
                                <i class="bi bi-code-slash me-1"></i>Yazılım
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 shadow-sm" onclick="loadDemo('crisis')">
                                <i class="bi bi-exclamation-triangle me-1"></i>Kriz
                            </button>
                            <button type="button" class="btn btn-outline-info btn-sm rounded-pill px-3 shadow-sm" onclick="loadDemo('management')">
                                <i class="bi bi-briefcase me-1"></i>Yönetim
                            </button>
                        </div>
                    </div>

                    <button type="submit" id="btnAnalyze" class="btn btn-primary w-100 py-3 fw-bold rounded-3 shadow">
                        <i class="bi bi-magic me-2"></i>Analiz Et
                    </button>
                </form>
            </div>
        </div>

        <!-- Son Analizler UI (Mockup) -->
        <div class="card glass-card">
            <div class="card-header bg-transparent border-bottom-0 pt-3 pb-0">
                <h6 class="fw-bold text-muted text-uppercase mb-0"><i class="bi bi-clock-history me-2"></i>Son Analizler</h6>
            </div>
            <div class="card-body p-2">
                <div class="analysis-history-card p-2 mb-1 rounded">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark small">Sprint Planning</span>
                        <span class="badge bg-light text-muted border">2 saat önce</span>
                    </div>
                    <p class="text-muted small mb-0 text-truncate">Frontend logindeki JWT token sorununu çözdün mü...</p>
                </div>
                <div class="analysis-history-card p-2 mb-1 rounded">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark small">Yönetim Toplantısı</span>
                        <span class="badge bg-light text-muted border">Dün</span>
                    </div>
                    <p class="text-muted small mb-0 text-truncate">Q3 hedeflerimiz hakkında konuşalım. Satışlar beklentinin...</p>
                </div>
                <div class="analysis-history-card p-2 rounded">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-dark small">Acil Prod Kriz</span>
                        <span class="badge bg-light text-muted border">3 gün önce</span>
                    </div>
                    <p class="text-muted small mb-0 text-truncate">Acil durum! Prod veritabanı %99 CPU kullanımında...</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Sağ Panel – Analiz Sonucu Görünümü -->
    <div class="col-lg-7 mb-4">
        <!-- Results Container -->
        <div class="card h-100 glass-card" id="resultsContainer" style="display: none;">
            <div class="card-header bg-transparent border-bottom-0 pt-4 pb-3 d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                <h5 class="card-title fw-bold text-dark mb-0"><i class="bi bi-ui-checks-grid me-2 text-success"></i>Analiz Raporu</h5>
                <button class="btn btn-sm btn-success fw-bold px-3 rounded-pill shadow-sm" onclick="copyReport()">
                    <i class="bi bi-clipboard me-1"></i>Raporu Kopyala
                </button>
            </div>
            <div class="card-body overflow-auto" style="max-height: 800px;" id="reportContent">
                
                <!-- AI İçgörüleri -->
                <div class="bg-indigo bg-opacity-10 p-3 rounded-3 mb-4 border-start border-4 border-indigo" style="background-color: #f5f3ff; border-left-color: #8b5cf6 !important;">
                    <h6 class="fw-bold mb-2" style="color: #6d28d9;"><i class="bi bi-lightbulb me-2"></i>AI İçgörüleri</h6>
                    <ul id="resInsights" class="list-unstyled mb-0 small" style="color: #4c1d95;"></ul>
                </div>

                <!-- Özet -->
                <div class="bg-white p-3 rounded-3 mb-4 border-start border-4 border-primary shadow-sm card-hover">
                    <h6 class="text-primary fw-bold mb-2"><i class="bi bi-card-text me-2"></i>Özet</h6>
                    <p id="resSummary" class="text-dark mb-0 small"></p>
                </div>

                <div class="row">
                    <!-- Skor Kartları -->
                    <div class="col-md-4 mb-3">
                        <div class="bg-white border rounded-3 p-3 text-center h-100 shadow-sm card-hover">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">Risk Skoru</h6>
                            <h4 class="fw-bold mb-1" id="resRiskScoreVal">0/10</h4>
                            <span id="resRiskBadge" class="badge bg-danger mb-2">Yüksek</span>
                            <div class="progress" style="height: 4px;">
                                <div id="resRiskProgress" class="progress-bar bg-danger" role="progressbar" style="width: 0%"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="bg-white border rounded-3 p-3 text-center h-100 shadow-sm card-hover">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">Kalite Skoru</h6>
                            <h4 class="text-success fw-bold mb-2" id="resQualityScore">0/100</h4>
                            <div class="progress progress-bar-custom bg-light">
                                <div id="resQualityProgress" class="progress-bar bg-success" role="progressbar" style="width: 0%"></div>
                            </div>
                            <small class="text-muted" style="font-size: 0.65rem;">Verimlilik Göstergesi</small>
                        </div>
                    </div>
                    <div class="col-md-4 mb-3">
                        <div class="bg-white border rounded-3 p-3 text-center h-100 shadow-sm card-hover">
                            <h6 class="text-muted small fw-bold text-uppercase mb-2">İş Yükü</h6>
                            <i class="bi bi-diagram-3 text-info fs-3 d-block mb-1"></i>
                            <span class="badge bg-info text-dark" id="resWorkload">Dengeli</span>
                        </div>
                    </div>
                </div>

                <div class="row mt-2">
                    <!-- Alınan Kararlar -->
                    <div class="col-md-6 mb-4">
                        <div class="bg-white p-3 rounded-3 h-100 border-start border-4 border-success shadow-sm card-hover">
                            <h6 class="text-success fw-bold border-bottom pb-2"><i class="bi bi-check2-circle me-2"></i>Kararlar</h6>
                            <ul id="resDecisions" class="list-unstyled text-dark small mt-2 mb-0"></ul>
                        </div>
                    </div>

                    <!-- Görevler / Action Items -->
                    <div class="col-md-6 mb-4">
                        <div class="bg-white p-3 rounded-3 h-100 border-start border-4 border-info shadow-sm card-hover">
                            <h6 class="text-info fw-bold border-bottom pb-2"><i class="bi bi-list-task me-2"></i>Görevler</h6>
                            <div id="resTasks" class="mt-2 text-dark small"></div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Riskler -->
                    <div class="col-md-6 mb-4">
                        <div class="bg-white p-3 rounded-3 h-100 border-start border-4 border-danger shadow-sm card-hover">
                            <h6 class="text-danger fw-bold border-bottom pb-2"><i class="bi bi-shield-exclamation me-2"></i>Riskler & Blokajlar</h6>
                            <ul id="resRisks" class="list-unstyled text-dark small mt-2 mb-0"></ul>
                        </div>
                    </div>

                    <!-- Deadline'lar -->
                    <div class="col-md-6 mb-4">
                        <div class="bg-white p-3 rounded-3 h-100 border-start border-4 shadow-sm card-hover" style="border-color: #f59e0b !important;">
                            <h6 class="fw-bold border-bottom pb-2" style="color: #f59e0b;"><i class="bi bi-calendar-event me-2"></i>Deadline’lar</h6>
                            <ul id="resDeadlines" class="list-unstyled text-dark small mt-2 mb-0"></ul>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <!-- Katılımcılar -->
                    <div class="col-md-6 mb-4">
                        <div class="bg-white p-3 rounded-3 h-100 border-start border-4 border-secondary shadow-sm card-hover">
                            <h6 class="text-secondary fw-bold border-bottom pb-2"><i class="bi bi-people me-2"></i>Katılımcılar</h6>
                            <div id="resParticipants" class="d-flex flex-wrap gap-2 mt-2"></div>
                        </div>
                    </div>

                    <!-- Önerilen Sonraki Adım -->
                    <div class="col-md-6 mb-4">
                        <div class="bg-white p-3 rounded-3 h-100 border-start border-4 border-primary shadow-sm card-hover">
                            <h6 class="text-primary fw-bold border-bottom pb-2"><i class="bi bi-arrow-right-circle me-2"></i>Sonraki Adım</h6>
                            <div class="bg-primary bg-opacity-10 p-2 rounded-3 mt-2">
                                <p id="resNextStep" class="text-primary fw-bold small mb-0"></p>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Bekleme Ekranı (Empty / Loading State) -->
        <div class="card h-100 d-flex justify-content-center align-items-center bg-white" id="emptyState" style="min-height: 500px; border: 2px dashed #cbd5e1 !important; border-radius: 1rem;">
            <div class="text-center text-muted p-5">
                <div id="loadingIconContainer">
                    <i class="bi bi-robot fs-1 mb-3 text-primary opacity-50"></i>
                </div>
                <div id="loadingSpinner" class="spinner-border text-primary mb-3" role="status" style="display: none; width: 3rem; height: 3rem;">
                    <span class="visually-hidden">Yükleniyor...</span>
                </div>
                <h5 id="emptyStateText" class="fw-bold text-secondary">Analiz Sonucu Bekleniyor</h5>
                <p class="small text-muted mt-2" id="emptyStateSubText">Toplantı analizi için metin girin ve Analiz Et butonuna tıklayın.</p>
                
                <div id="loadingProgressContainer" class="mt-4 w-100" style="display: none; max-width: 300px; margin: 0 auto;">
                    <div class="progress progress-bar-custom bg-light">
                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%"></div>
                    </div>
                    <small class="text-primary mt-2 d-inline-block typing-text fw-bold">Modeller yükleniyor</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const scenarios = {
            software: {
                text: "Ahmet: Arkadaşlar merhaba, sprint planlama toplantısına hoş geldiniz. Ayşe, frontend logindeki JWT token sorununu çözdün mü?\nAyşe: Merhaba Ahmet. Evet çözdüm, PR açtım. Ancak backend tarafında yeni API endpointi henüz hazır değil. Mehmet o kısmı yarına yetiştirebilir misin?\nMehmet: Yarın öğleye kadar bitirmiş olurum. Yalnız veritabanında migration patlayabilir, risk var. Ali'nin kontrol etmesi lazım.\nAhmet: Tamam, Mehmet yarın öğleye kadar backend API'yi bitirecek. Ali, lütfen bugün migration'ı test et. Bu bir risk. Karar olarak: Auth sistemi yarına canlıya alınacak. Sonraki adım: Test ortamında tam entegrasyon denemesi yapmak.",
                mockData: {
                    summary: "Sprint planlama toplantısında JWT token sorununun çözüldüğü belirtildi ve backend API geliştirmesi ile veritabanı migration süreçleri planlandı.",
                    insights: [
                        "Toplantıda risk analizi hızlı yapılmış, ancak test süreçleri için ayrılan süre dar.",
                        "Deadline yoğunluğu yarına sıkışmış durumda."
                    ],
                    decisions: ["Auth sistemi yarına canlıya alınacak."],
                    tasks: [
                        { text: "Backend API endpointini bitir.", owner: "Mehmet", deadline: "Yarın öğle", priority: "danger" },
                        { text: "Migration'ı test et.", owner: "Ali", deadline: "Bugün", priority: "warning" }
                    ],
                    risks: ["Veritabanı migration'ı patlayabilir."],
                    deadlines: ["Backend API: Yarın öğle", "Migration Test: Bugün"],
                    participants: ["Ahmet", "Ayşe", "Mehmet", "Ali"],
                    nextStep: "Test ortamında tam entegrasyon denemesi yapmak.",
                    riskScore: { val: 4, text: "Orta", color: "warning" },
                    qualityScore: 85,
                    workload: "Backend Yoğun"
                }
            },
            crisis: {
                text: "Can: Acil durum! Prod veritabanı %99 CPU kullanımında, sistem yavaşladı. Zeynep, acil loglara bakar mısın?\nZeynep: Bakıyorum... Son deploy edilen rapordan kaynaklı çok ağır bir sorgu var. Acil rollback yapalım mı?\nCan: Evet, hemen rollback yapıyoruz. Karar: Son deploy geri alınacak. Görev: Zeynep, rollback işlemini başlat. 15 dakika içinde sistemi ayağa kaldırmamız lazım. Hakan, sen de o arada ağır sorguyu optimize et.\nHakan: Anlaşıldı. Rollback sonrası sorguyu indexleyeceğim. Risk şu ki müşteri rapor alamıyor şu an. Sonraki adım: Veritabanı monitoring alarmlarını sıkılaştırmak.",
                mockData: {
                    summary: "Sistemdeki %99 CPU kullanımına yol açan ağır sorgu tespit edildi, acil rollback kararı alındı ve optimizasyon süreci başlatıldı.",
                    insights: [
                        "Kriz yönetimi hızlı işletilmiş, iletişim net.",
                        "Kök neden analizine (RCA) daha fazla zaman ayrılması gerekebilir."
                    ],
                    decisions: ["Son deploy acil olarak geri alınacak."],
                    tasks: [
                        { text: "Rollback işlemini başlat.", owner: "Zeynep", deadline: "Hemen", priority: "danger" },
                        { text: "Ağır sorguyu optimize et.", owner: "Hakan", deadline: "Kısa Vade", priority: "warning" }
                    ],
                    risks: ["Müşteriler şu an rapor alamıyor.", "Sistem kesintisi riski devam ediyor."],
                    deadlines: ["Sistemi ayağa kaldırma: 15 dakika"],
                    participants: ["Can", "Zeynep", "Hakan"],
                    nextStep: "Veritabanı monitoring alarmlarını sıkılaştırmak.",
                    riskScore: { val: 9, text: "Yüksek", color: "danger" },
                    qualityScore: 70,
                    workload: "Çok Yoğun"
                }
            },
            management: {
                text: "Elif: Q3 hedeflerimiz hakkında konuşalım. Satışlar beklentinin altında kaldı. Murat, pazarlama bütçesini artırabilir miyiz?\nMurat: Bütçemiz kısıtlı ama sosyal medya reklamlarına ağırlık verebiliriz. Bunun için ek 50.000 TL bütçe onaylıyorum.\nElif: Harika. Karar: Sosyal medya reklam bütçesi 50.000 TL artırıldı. Görev: Ayşe, haftaya pazartesiye kadar yeni reklam kampanyası taslaklarını hazırla. Risk: Reklam dönüşümleri yeterli olmazsa yıl sonu hedefi tutmayabilir. Sonraki adım: Çarşamba günü taslaklar üzerinden tekrar toplanıp onaylamak.",
                mockData: {
                    summary: "Q3 satışlarının düşük kalması sebebiyle sosyal medya reklam bütçesi artırıldı ve yeni kampanya süreci planlandı.",
                    insights: [
                        "Karar alma süreci çok verimli.",
                        "Bütçe onayları toplantı esnasında hızlıca çözülmüş."
                    ],
                    decisions: ["Sosyal medya reklam bütçesi 50.000 TL artırıldı."],
                    tasks: [
                        { text: "Yeni reklam kampanyası taslaklarını hazırla.", owner: "Ayşe", deadline: "Haftaya Pzt", priority: "info" }
                    ],
                    risks: ["Reklam dönüşümleri yetersiz kalırsa hedef tutmayabilir."],
                    deadlines: ["Reklam taslakları: Haftaya pazartesi", "Onay toplantısı: Çarşamba"],
                    participants: ["Elif", "Murat", "Ayşe"],
                    nextStep: "Çarşamba günü taslaklar üzerinden tekrar toplanıp onaylamak.",
                    riskScore: { val: 3, text: "Düşük", color: "success" },
                    qualityScore: 92,
                    workload: "Dengeli"
                }
            }
        };

        let currentMockData = null;

        function loadDemo(type) {
            const data = scenarios[type];
            if(data) {
                document.getElementById('MeetingText').value = data.text;
                currentMockData = data.mockData;
            }
        }


        function populateResults(data) {
            document.getElementById('resSummary').innerText = data.summary;
            document.getElementById('resNextStep').innerText = data.nextStep;
            
            // Risk Score
            document.getElementById('resRiskScoreVal').innerText = data.riskScore.val + "/10";
            document.getElementById('resRiskBadge').className = "badge mb-2 bg-" + data.riskScore.color;
            document.getElementById('resRiskBadge').innerText = data.riskScore.text;
            document.getElementById('resRiskProgress').className = "progress-bar bg-" + data.riskScore.color;
            document.getElementById('resRiskProgress').style.width = (data.riskScore.val * 10) + "%";

            // Quality Score
            document.getElementById('resQualityScore').innerText = data.qualityScore + "/100";
            document.getElementById('resQualityProgress').style.width = data.qualityScore + "%";
            let qColor = data.qualityScore > 80 ? 'success' : (data.qualityScore > 60 ? 'warning' : 'danger');
            document.getElementById('resQualityProgress').className = "progress-bar bg-" + qColor;
            document.getElementById('resQualityScore').className = "fw-bold mb-2 text-" + qColor;

            document.getElementById('resWorkload').innerText = data.workload;

            const makeList = (items, iconClass) => items.map(i => `<li class="mb-2"><i class="bi ${iconClass} text-muted me-2"></i>${i}</li>`).join('');
            
            document.getElementById('resInsights').innerHTML = makeList(data.insights, 'bi-stars text-warning');
            document.getElementById('resDecisions').innerHTML = makeList(data.decisions, 'bi-arrow-right-short');
            document.getElementById('resRisks').innerHTML = makeList(data.risks, 'bi-exclamation-triangle text-danger');
            document.getElementById('resDeadlines').innerHTML = makeList(data.deadlines, 'bi-clock text-warning');

            // Complex Tasks List
            const taskHtml = data.tasks.map(t => `
                <div class="task-item p-2 mb-1 d-flex align-items-start">
                    <i class="bi bi-square me-2 mt-1 text-muted"></i>
                    <div>
                        <span class="d-block fw-bold mb-1">${t.text}</span>
                        <span class="badge bg-secondary border me-1"><i class="bi bi-person me-1"></i>${t.owner}</span>
                        <span class="badge bg-light text-dark border me-1"><i class="bi bi-calendar me-1"></i>${t.deadline}</span>
                        <span class="badge bg-${t.priority} bg-opacity-25 text-${t.priority} border border-${t.priority}">Öncelikli</span>
                    </div>
                </div>
            `).join('');
            document.getElementById('resTasks').innerHTML = taskHtml;

            const badges = data.participants.map(p => `<span class="badge bg-light text-dark border px-3 py-2 rounded-pill shadow-sm"><i class="bi bi-person-fill text-secondary me-1"></i>${p}</span>`).join('');
            document.getElementById('resParticipants').innerHTML = badges;
        }

        function copyReport() {
            const reportNode = document.getElementById('reportContent');
            const text = reportNode.innerText; 
            
            navigator.clipboard.writeText(text).then(() => {
                // Show Bootstrap Toast instead of alert
                var toastEl = document.getElementById('copyToast');
                var toast = new bootstrap.Toast(toastEl);
                toast.show();
            }).catch(err => {
                console.error("Kopyalama hatası: ", err);
                alert("Kopyalanırken bir hata oluştu.");
            });
        }

        // --- Web Speech API Logic ---
        let recognition = null;
        let finalTranscript = "";

        if ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window) {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            recognition = new SpeechRecognition();
            recognition.lang = 'tr-TR';
            recognition.continuous = true;
            recognition.interimResults = true;

            recognition.onstart = function() {
                document.getElementById('btnStartRecording').disabled = true;
                document.getElementById('btnStopRecording').disabled = false;
                document.getElementById('speechStatusText').innerText = "Dinleniyor, konuşmanız metne aktarılıyor...";
                document.getElementById('speechPulseIndicator').classList.remove('d-none');
            };

            recognition.onresult = function(event) {
                let interimTranscript = "";
                for (let i = event.resultIndex; i < event.results.length; ++i) {
                    if (event.results[i].isFinal) {
                        finalTranscript += event.results[i][0].transcript + " ";
                    } else {
                        interimTranscript += event.results[i][0].transcript;
                    }
                }
                const textArea = document.getElementById('MeetingText');
                textArea.value = finalTranscript + interimTranscript;
            };

            recognition.onerror = function(event) {
                const statusText = document.getElementById('speechStatusText');
                document.getElementById('speechPulseIndicator').classList.add('d-none');
                
                switch (event.error) {
                    case 'not-allowed':
                        statusText.innerText = "Mikrofon izni verilmedi.";
                        break;
                    case 'no-speech':
                        statusText.innerText = "Konuşma algılanamadı.";
                        break;
                    case 'network':
                        statusText.innerText = "Ses tanıma servisine bağlanılamadı.";
                        break;
                    default:
                        statusText.innerText = "Ses tanıma sırasında hata oluştu.";
                        break;
                }
                document.getElementById('btnStartRecording').disabled = false;
                document.getElementById('btnStopRecording').disabled = true;
            };

            recognition.onend = function() {
                if(document.getElementById('btnStopRecording').disabled === false) {
                    // Beklenmeyen kapanma (örn: belli bir süre konuşulmayınca)
                    document.getElementById('btnStartRecording').disabled = false;
                    document.getElementById('btnStopRecording').disabled = true;
                    document.getElementById('speechPulseIndicator').classList.add('d-none');
                    document.getElementById('speechStatusText').innerText = "Metin hazır. Analiz Et butonuna basabilirsiniz.";
                }
            };

        } else {
            document.addEventListener("DOMContentLoaded", function() {
                document.getElementById('btnStartRecording').disabled = true;
                document.getElementById('btnStopRecording').disabled = true;
                document.getElementById('speechStatusText').innerText = "Tarayıcınız canlı ses tanımayı desteklemiyor. Lütfen Chrome kullanın.";
            });
        }

        function startSpeechRecognition() {
            if (recognition) {
                try {
                    // Kullanıcı daha önce bir şeyler yazmış/silmiş olabilir. Textarea value'sunu finalTranscript'e eşitle ki üstüne yazsın.
                    finalTranscript = document.getElementById('MeetingText').value; 
                    if(finalTranscript && finalTranscript.length > 0 && !finalTranscript.endsWith(" ")) {
                        finalTranscript += " ";
                    }
                    recognition.start();
                } catch(e) {
                    console.error("Zaten çalışıyor olabilir.", e);
                }
            }
        }

        function stopSpeechRecognition() {
            if (recognition) {
                recognition.stop();
                document.getElementById('btnStartRecording').disabled = false;
                document.getElementById('btnStopRecording').disabled = true;
                document.getElementById('speechPulseIndicator').classList.add('d-none');
                document.getElementById('speechStatusText').innerText = "Metin hazır. Analiz Et butonuna basabilirsiniz.";
            }
        }

        function clearSpeechText() {
            finalTranscript = "";
            document.getElementById('MeetingText').value = "";
            document.getElementById('speechStatusText').innerText = "Metin temizlendi.";
        }

        @if (ViewBag.AnalysisResult != null)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                var analysisData = @Html.Raw(Json.Serialize(ViewBag.AnalysisResult));
                document.getElementById('emptyState').style.display = 'none';
                var resultsContainer = document.getElementById('resultsContainer');
                resultsContainer.style.display = 'block';
                resultsContainer.classList.add('fade-in');
                populateResults(analysisData);
            });
            </text>
        }
    </script>
}
