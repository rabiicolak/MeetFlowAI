@model MeetFlow.Web.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- AI Plan Agent: Dashboard metrikleri, manuel iş yükü azaltımını görünür hale getirmek için planlanmıştır. -->
<div class="container-fluid py-4">
    <!-- 1. Üst Başlık Alanı -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-gray-800 fw-bold">MeetFlow AI Dashboard</h1>
            <p class="text-muted mb-0">Toplantı analizleri, ses kayıtları, rapor paylaşımları ve zaman tasarrufu metrikleri.</p>
        </div>
    </div>

    <!-- 2. Genel İstatistik Kartları -->
    <h5 class="mb-3 text-secondary fw-bold">Genel İstatistikler</h5>
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card glass-card card-hover h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-xs fw-bold text-primary text-uppercase mb-1">Toplam Analiz</div>
                    <div class="h4 mb-0 fw-bold text-dark">@Model.TotalAnalysis</div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card glass-card card-hover h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-xs fw-bold text-success text-uppercase mb-1">Ses Analizi</div>
                    <div class="h4 mb-0 fw-bold text-dark">@Model.TotalAudioAnalysis</div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card glass-card card-hover h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-xs fw-bold text-info text-uppercase mb-1">Kazanılan Süre</div>
                    <div class="h4 mb-0 fw-bold text-dark">@Model.TotalTimeSaved saat</div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card glass-card card-hover h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-xs fw-bold text-warning text-uppercase mb-1">Ort. Verimlilik</div>
                    <div class="h4 mb-0 fw-bold text-dark">%@Model.AverageEfficiency</div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card glass-card card-hover h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-xs fw-bold text-danger text-uppercase mb-1">Ort. Risk Skoru</div>
                    <div class="h4 mb-0 fw-bold text-dark">%@Model.AverageRiskScore</div>
                </div>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="card glass-card card-hover h-100 border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-xs fw-bold text-secondary text-uppercase mb-1">Gönderilen Rapor</div>
                    <div class="h4 mb-0 fw-bold text-dark">@Model.TotalReportsSent</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <!-- 3. Ses Analizi Kartları -->
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h5 class="mb-3 text-secondary fw-bold">Ses Analizi Detayları</h5>
            <div class="row g-3">
                <div class="col-sm-6">
                    <div class="card glass-card card-hover border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-xs fw-bold text-muted text-uppercase mb-1">Bugünkü Kayıtlar</div>
                            <div class="h5 mb-0 fw-bold">@Model.TodayAudioRecords</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card glass-card card-hover border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-xs fw-bold text-muted text-uppercase mb-1">Transkript Güven Skoru</div>
                            <div class="h5 mb-0 fw-bold text-success">%@Model.AvgTranscriptConfidence</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card glass-card card-hover border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-xs fw-bold text-muted text-uppercase mb-1">En Uzun Toplantı</div>
                            <div class="h5 mb-0 fw-bold">@Model.LongestMeetingMinutes dk</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="card glass-card card-hover border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="text-xs fw-bold text-muted text-uppercase mb-1">Türkçe Dil Tespiti</div>
                            <div class="h5 mb-0 fw-bold text-primary">%@Model.TurkishDetectionRate</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 4. Rapor Paylaşım Kartları -->
        <div class="col-lg-6">
            <h5 class="mb-3 text-secondary fw-bold">Rapor Export Türleri</h5>
            <div class="row g-3">
                <div class="col-sm-3 col-6">
                    <div class="card glass-card card-hover border-0 shadow-sm text-center h-100">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <i class="bi bi-envelope fs-3 text-primary mb-2"></i>
                            <div class="h5 mb-0 fw-bold">@Model.EmailReports</div>
                            <div class="text-xs text-muted">Mail</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="card glass-card card-hover border-0 shadow-sm text-center h-100">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <i class="bi bi-filetype-html fs-3 text-danger mb-2"></i>
                            <div class="h5 mb-0 fw-bold">@Model.HtmlExport</div>
                            <div class="text-xs text-muted">HTML</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="card glass-card card-hover border-0 shadow-sm text-center h-100">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <i class="bi bi-markdown fs-3 text-dark mb-2"></i>
                            <div class="h5 mb-0 fw-bold">@Model.MarkdownExport</div>
                            <div class="text-xs text-muted">MD</div>
                        </div>
                    </div>
                </div>
                <div class="col-sm-3 col-6">
                    <div class="card glass-card card-hover border-0 shadow-sm text-center h-100">
                        <div class="card-body p-3 d-flex flex-column justify-content-center">
                            <i class="bi bi-file-text fs-3 text-secondary mb-2"></i>
                            <div class="h5 mb-0 fw-bold">@Model.TxtExport</div>
                            <div class="text-xs text-muted">TXT</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. Grafik Alanı -->
    <h5 class="mb-3 text-secondary fw-bold">Görsel Analitikler</h5>
    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="card glass-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-muted mb-3">Haftalık Analiz Sayısı</h6>
                    <canvas id="weeklyAnalysisChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card glass-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h6 class="card-title fw-bold text-muted mb-3">Kazanılan Süre (Saat)</h6>
                    <canvas id="timeSavedChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card glass-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column align-items-center">
                    <h6 class="card-title fw-bold text-muted mb-3 w-100">Risk Skoru Dağılımı</h6>
                    <div style="width: 70%; max-height: 300px;">
                        <canvas id="riskScoreChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card glass-card border-0 shadow-sm h-100">
                <div class="card-body d-flex flex-column align-items-center">
                    <h6 class="card-title fw-bold text-muted mb-3 w-100">Rapor Export Türleri</h6>
                    <div style="width: 70%; max-height: 300px;">
                        <canvas id="exportTypesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-4 g-4">
        <!-- 6. Son Toplantılar Tablosu -->
        <div class="col-lg-8">
            <div class="card glass-card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-secondary mb-3">Son Toplantılar</h5>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Toplantı Adı</th>
                                    <th>Tür</th>
                                    <th>Kaynak</th>
                                    <th>Risk Skoru</th>
                                    <th>Kalite Skoru</th>
                                    <th>Verimlilik</th>
                                    <th>Rapor Durumu</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var meeting in Model.RecentMeetings)
                                {
                                    <tr>
                                        <td class="fw-bold text-dark">@meeting.Title</td>
                                        <td><span class="badge bg-secondary">@meeting.Type</span></td>
                                        <td>
                                            @if (meeting.Source == "Ses")
                                            {
                                                <i class="bi bi-mic-fill text-primary"></i> <span class="ms-1">@meeting.Source</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-file-text-fill text-info"></i> <span class="ms-1">@meeting.Source</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="progress" style="height: 6px;">
                                                <div class="progress-bar @(meeting.RiskScore > 50 ? "bg-danger" : (meeting.RiskScore > 30 ? "bg-warning" : "bg-success"))" 
                                                     role="progressbar" style="width: @meeting.RiskScore%" aria-valuenow="@meeting.RiskScore" aria-valuemin="0" aria-valuemax="100"></div>
                                            </div>
                                            <small class="text-muted fw-bold">%@meeting.RiskScore</small>
                                        </td>
                                        <td class="fw-bold">%@meeting.QualityScore</td>
                                        <td class="fw-bold">%@meeting.Efficiency</td>
                                        <td>
                                            @if (meeting.ReportStatus == "Gönderildi")
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success">@meeting.ReportStatus</span>
                                            }
                                            else if (meeting.ReportStatus == "Bekliyor")
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">@meeting.ReportStatus</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info">@meeting.ReportStatus</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 7. AI İçgörüleri Paneli -->
        <div class="col-lg-4">
            <div class="card glass-card border-0 shadow-sm h-100 border-start border-4 border-primary">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-primary mb-4 d-flex align-items-center">
                        <i class="bi bi-robot fs-4 me-2"></i> AI İçgörüleri
                    </h5>
                    
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <i class="bi bi-lightbulb-fill text-warning fs-5"></i>
                        </div>
                        <div class="ms-3">
                            <p class="mb-0 text-dark fw-medium">Sesli toplantılarda aksiyon yoğunluğu yüksek.</p>
                        </div>
                    </div>
                    
                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                        </div>
                        <div class="ms-3">
                            <p class="mb-0 text-dark fw-medium">Risk skorları kriz toplantılarında artış gösteriyor.</p>
                        </div>
                    </div>

                    <div class="d-flex mb-3">
                        <div class="flex-shrink-0">
                            <i class="bi bi-share-fill text-info fs-5"></i>
                        </div>
                        <div class="ms-3">
                            <p class="mb-0 text-dark fw-medium">Rapor paylaşımı manuel iletişim süresini azaltıyor.</p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="flex-shrink-0">
                            <i class="bi bi-graph-up-arrow text-success fs-5"></i>
                        </div>
                        <div class="ms-3">
                            <p class="mb-0 text-dark fw-medium">Ortalama verimlilik hedeflenen %50 azaltımın üzerinde.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Haftalık Analiz Sayısı (Line Chart)
            const ctxWeekly = document.getElementById('weeklyAnalysisChart').getContext('2d');
            new Chart(ctxWeekly, {
                type: 'line',
                data: {
                    labels: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'],
                    datasets: [{
                        label: 'Analiz Sayısı',
                        data: [12, 19, 15, 25, 22, 10, 25],
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        borderWidth: 2,
                        tension: 0.4,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            // Kazanılan Süre (Bar Chart)
            const ctxTime = document.getElementById('timeSavedChart').getContext('2d');
            new Chart(ctxTime, {
                type: 'bar',
                data: {
                    labels: ['Oca', 'Şub', 'Mar', 'Nis', 'May'],
                    datasets: [{
                        label: 'Saat',
                        data: [10, 15, 12, 20, 19],
                        backgroundColor: '#20c997',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true } }
                }
            });

            // Risk Skoru Dağılımı (Doughnut Chart)
            const ctxRisk = document.getElementById('riskScoreChart').getContext('2d');
            new Chart(ctxRisk, {
                type: 'doughnut',
                data: {
                    labels: ['Düşük Risk', 'Orta Risk', 'Yüksek Risk'],
                    datasets: [{
                        data: [60, 25, 15],
                        backgroundColor: ['#198754', '#ffc107', '#dc3545'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '70%',
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // Rapor Export Türleri (Pie Chart)
            const ctxExport = document.getElementById('exportTypesChart').getContext('2d');
            new Chart(ctxExport, {
                type: 'pie',
                data: {
                    labels: ['Mail', 'HTML', 'Markdown', 'TXT'],
                    datasets: [{
                        data: [@Model.EmailReports, @Model.HtmlExport, @Model.MarkdownExport, @Model.TxtExport],
                        backgroundColor: ['#0d6efd', '#dc3545', '#212529', '#6c757d'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
}
